{#- Pagina Poteri. Passa da Nunjucks nella build (strumenti/build.mjs): i selettori dei poteri vengono dagli id di dati/.
    Niente lettere accentate nemmeno qui: finiscono nel CSS. -#}
/* Pagina Poteri: una card per potere, due colonne. Gli input nascosti in cima alla card (potere, livello, tipo,
   aperto) decidono cosa si vede: il testo del potere scelto, i livelli posseduti, i testi del manuale. */
{#- Ogni potere del menu: valore di attr_potere, classe del suo blocco di testo, numero di livelli. Poi gli elenchi di
    selettori, uniti con la virgola. -#}
{% set valori = [] %}
{% for p in dati.poteri %}{% set _ = valori.push({ "valore": p.id, "livelli": p.livelli.length }) %}{% endfor %}
{% for c in dati.carriere %}{% for p in c.poteri %}{% set _ = valori.push({ "valore": c.id + "/" + p.id, "livelli": p.livelli.length }) %}{% endfor %}{% endfor %}
{% set mostra = [] %}
{% set pallini = [] %}
{% for v in valori %}
{% set _ = mostra.push(".potere-scelto[value=\"" + v.valore + "\"] ~ .testi-potere .potere-" + (v.valore | replace("/", "--"))) %}
{% if v.livelli < 5 %}{% set _ = pallini.push(".potere-scelto[value=\"" + v.valore + "\"] ~ .testa-potere .pallino:nth-of-type(n+" + (v.livelli + 1) + ")") %}{% endif %}
{% endfor %}
{% set posseduti = [] %}
{% for n in range(1, 6) %}{% for k in range(1, n + 1) %}{% set _ = posseduti.push(".livello-scelto[value=\"" + n + "\"] ~ .testi-potere .liv-" + k) %}{% endfor %}{% endfor %}
.scheda .intro-poteri {
  margin-bottom: 12px;
}
.scheda .intro-poteri h3 {
  margin: 0;
}
.scheda .pagina-poteri .repcontainer {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  align-items: start;
}
@container (max-width: 700px) {
  .scheda .pagina-poteri .repcontainer {
    grid-template-columns: minmax(0, 1fr);
  }
}
.scheda .pagina-poteri .repitem {
  position: relative;
  border-bottom: none;
}
.scheda .potere {
  padding: 10px 12px;
  background: var(--riquadro);
  border: 1px solid var(--bordo);
  border-radius: 12px;
  box-shadow: var(--ombra);
}

/* Testa: menu, pallini, pulsante dei testi */
.scheda .testa-potere {
  display: flex;
  align-items: center;
  gap: 8px;
}
.scheda .testa-potere select {
  flex: 1 1 auto;
  min-width: 0;
  font-weight: 700;
}
.scheda .pallini-potere {
  flex: none;
}
.scheda button.apri-potere[name] {
  flex: none;
  padding: 2px 10px;
  font: 700 11px/1.6 "Alegreya Sans SC", sans-serif;
  letter-spacing: 0.08em;
  color: var(--ruggine);
  background: var(--carta);
  border: 1px solid var(--bordo);
  border-radius: 99px;
  cursor: pointer;
}
.aperto-scelto[value="1"] ~ .testa-potere button.apri-potere[name] {
  color: #fff;
  background: var(--ruggine);
  border-color: var(--ruggine);
}
.scheda .nome-potere {
  display: none;
  width: 100%;
  margin-top: 6px;
}
.potere-scelto[value=""] ~ .nome-potere {
  display: block;
}
.scheda .note-potere {
  width: 100%;
  margin-top: 6px;
}

/* Etichette innato e affine: le scrive lo script dall archetipo (attr_tipo) */
.scheda .etichette-potere {
  display: none;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
}
.tipo-scelto[value="innato"] ~ .etichette-potere,
.tipo-scelto[value="affine"] ~ .etichette-potere {
  display: flex;
}
.scheda .tag-potere {
  display: none;
  padding: 0 8px;
  font: 500 12px/1.6 "Alegreya Sans", sans-serif;
  color: var(--ruggine);
  background: var(--ruggine-chiaro);
  border-radius: 99px;
}
.tipo-scelto[value="innato"] ~ .etichette-potere .tag-innato,
.tipo-scelto[value="affine"] ~ .etichette-potere .tag-affine {
  display: inline;
}
.scheda .nota-meta {
  font-size: 12px;
  color: var(--tenue);
}

/* Testi del manuale: solo quelli del potere scelto */
.scheda .testo-potere {
  display: none;
  margin-top: 6px;
  font-size: 14px;
}
{$ mostra | join(",\n") $} {
  display: block;
}
.scheda .cat-potere {
  margin-bottom: 4px;
  font-size: 12px;
  color: var(--tenue);
}
.scheda .testo-potere p {
  margin: 0 0 6px;
}
.scheda .solo-aperto {
  display: none;
}
.aperto-scelto[value="1"] ~ .testi-potere .solo-aperto {
  display: block;
}
.scheda .livelli-potere {
  margin: 4px 0 0;
  padding: 0;
  list-style: none;
}
.scheda .livelli-potere .liv {
  padding: 4px 0;
  color: #b9ad9c;
  border-top: 1px dashed var(--bordo);
}
.scheda .liv-testa {
  display: grid;
  grid-template-columns: 52px 1fr auto;
  gap: 8px;
  align-items: baseline;
}
.scheda .pallini-liv {
  letter-spacing: 1px;
}
.scheda .liv .costo {
  font-size: 12px;
  white-space: nowrap;
}
.scheda .testo-liv {
  margin-top: 4px;
}
.scheda .attacco-potere {
  font-weight: 700;
}
.scheda .opportunita-potere {
  margin: 0 0 6px;
  padding-left: 16px;
}
.scheda .opportunita-potere li {
  margin-bottom: 2px;
}
.scheda .voce-potere {
  padding-top: 4px;
  border-top: 1px dashed var(--bordo);
}
.scheda .riquadro-manuale {
  margin-top: 6px;
  padding: 8px 10px;
  font-size: 13px;
  background: var(--carta-2);
  border-radius: 8px;
}

/* Livelli posseduti in pieno, gli altri in grigio */
{$ posseduti | join(",\n") $} {
  color: var(--inchiostro);
}
.scheda .liv .costo {
  color: var(--tenue);
}

/* Pallini oltre i livelli del potere: nascosti */
{$ pallini | join(",\n") $} {
  display: none;
}
