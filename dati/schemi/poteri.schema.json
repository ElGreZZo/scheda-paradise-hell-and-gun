{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poteri",
  "$ref": "comune.schema.json#/$defs/file",
  "unevaluatedProperties": false,
  "properties": {
    "voci": {
      "items": {
        "$ref": "#/$defs/voce"
      }
    }
  },
  "$defs": {
    "voce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "categoria",
        "testo",
        "livelli"
      ],
      "properties": {
        "id": {
          "$ref": "comune.schema.json#/$defs/id"
        },
        "nome": {
          "$ref": "comune.schema.json#/$defs/testo"
        },
        "categoria": {
          "enum": [
            "comune",
            "passivo",
            "attivo",
            "superiore"
          ]
        },
        "solo": {
          "description": "Colore richiesto (Solo bianchi, Solo neri).",
          "enum": [
            "bianco",
            "nero"
          ]
        },
        "testo": {
          "description": "Testo del potere fuori dai livelli (descrizione e regole comuni a tutti i livelli).",
          "$ref": "comune.schema.json#/$defs/testi"
        },
        "livelli": {
          "$ref": "comune.schema.json#/$defs/livelli"
        },
        "effetti_scenografici": {
          "$ref": "comune.schema.json#/$defs/testi"
        },
        "reazione": {
          "description": "Reazione contro altri poteri (cap. 10, Reazioni).",
          "$ref": "comune.schema.json#/$defs/testi"
        },
        "effetto_combo": {
          "description": "Effetto combo con altri poteri.",
          "$ref": "comune.schema.json#/$defs/testi"
        },
        "riquadri": {
          "description": "Riquadri del manuale dentro il potere (Istruzioni, La regola del cool).",
          "$ref": "comune.schema.json#/$defs/testi"
        }
      }
    }
  }
}
