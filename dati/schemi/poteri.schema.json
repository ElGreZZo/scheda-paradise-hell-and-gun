{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poteri",
  "$ref": "comune.schema.json#/$defs/file",
  "unevaluatedProperties": false,
  "properties": {
    "voci": {
      "items": {
        "$ref": "#/$defs/voce"
      }
    }
  },
  "$defs": {
    "voce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "categoria",
        "livelli",
        "reazione",
        "effetto_combo"
      ],
      "properties": {
        "id": {
          "$ref": "comune.schema.json#/$defs/id"
        },
        "nome": {
          "$ref": "comune.schema.json#/$defs/testo"
        },
        "categoria": {
          "enum": [
            "comune",
            "passivo",
            "attivo",
            "superiore"
          ]
        },
        "solo": {
          "description": "Colore richiesto (Solo bianchi, Solo neri).",
          "enum": [
            "bianco",
            "nero"
          ]
        },
        "livelli": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "livello",
              "costo_px"
            ],
            "properties": {
              "livello": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "nome": {
                "$ref": "comune.schema.json#/$defs/testo"
              },
              "costo_px": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "reazione": {
          "description": "Il potere ha una reazione.",
          "type": "boolean"
        },
        "effetto_combo": {
          "description": "Il potere ha un effetto combo con altri poteri.",
          "type": "boolean"
        }
      }
    }
  }
}
