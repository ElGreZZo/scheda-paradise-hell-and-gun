{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caratteristiche",
  "$ref": "comune.schema.json#/$defs/file",
  "unevaluatedProperties": false,
  "properties": {
    "voci": {
      "items": {
        "$ref": "#/$defs/voce"
      }
    }
  },
  "$defs": {
    "voce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "descrizione",
        "effetti"
      ],
      "properties": {
        "id": {
          "$ref": "comune.schema.json#/$defs/caratteristica"
        },
        "nome": {
          "$ref": "comune.schema.json#/$defs/testo"
        },
        "descrizione": {
          "$ref": "comune.schema.json#/$defs/testi"
        },
        "effetti": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nome",
              "testo"
            ],
            "properties": {
              "nome": {
                "$ref": "comune.schema.json#/$defs/testo"
              },
              "testo": {
                "$ref": "comune.schema.json#/$defs/testo"
              }
            }
          }
        }
      }
    }
  }
}
